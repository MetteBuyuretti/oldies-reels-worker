    "content": "<!-- wp:html -->\n<style>\n\nbody.postid-4300 main>.page-hero,body.postid-4301 main>.page-hero,body.postid-4817 main>.page-hero,body.postid-4818 main>.page-hero{display:none}\nbody.postid-4300 .single-news-feature,body.postid-4301 .single-news-feature,body.postid-4817 .single-news-feature,body.postid-4818 .single-news-feature{display:none}\n.monthly-news{--gold:#d8bd75;--cream:#eee8da;--muted:#b9b2a4;--line:#564837;--wine:#842b34;width:min(1120px,calc(100vw - 32px));max-width:none;margin:0 0 0 50%;transform:translateX(-50%);box-sizing:border-box;color:var(--cream);font-family:Arial,Helvetica,sans-serif;line-height:1.6;background:#111316;border:1px solid #3f3731}\n.monthly-news *{box-sizing:border-box}.monthly-news a{color:#e6c77e;text-underline-offset:3px;overflow-wrap:anywhere}\n.monthly-news .monthly-banner{position:relative;isolation:isolate;overflow:hidden;display:grid;grid-template-columns:minmax(0,1.4fr) minmax(230px,.8fr);align-items:center;gap:18px;min-height:360px;padding:42px clamp(22px,5vw,56px);background:radial-gradient(ellipse at 85% 12%,#a2704133,transparent 60%),linear-gradient(120deg,#5e1725,#27171b 56%,#111316);border-bottom:3px solid var(--gold)}\n.monthly-news .monthly-banner:before{content:'';position:absolute;inset:14px;border:1px solid #d8bd753d;pointer-events:none;z-index:-1}\n.monthly-news .monthly-brand{display:block;color:var(--gold);font-size:12px;letter-spacing:.19em;font-weight:800;margin-bottom:26px}.monthly-news .monthly-kicker{display:block;font-size:11px;font-weight:700;letter-spacing:.16em;color:#dfc7a4;text-transform:uppercase;margin-bottom:10px}\n.monthly-news .monthly-title{font-family:Georgia,serif!important;color:#fff0cb!important;font-size:clamp(42px,6.2vw,76px)!important;line-height:1.02!important;letter-spacing:-.035em;margin:0 0 16px!important;padding:0!important;border:0!important;background:none!important}.monthly-news .monthly-title span{display:block;color:#cfad6a;font-size:.56em;letter-spacing:.09em;ma