-portrait{margin:0!important;background:#141518}.monthly-news .augx-portrait img{width:100%!important;height:240px!important;object-fit:contain!important;object-position:center;display:block;background:radial-gradient(ellipse,#333137,#16171a);margin:0!important}.monthly-news .augx-portrait figcaption{padding:10px 15px;font-size:10px;line-height:1.45;color:#b9b2a4;background:#202124;overflow-wrap:anywhere}.monthly-news .augx-text{padding:22px;min-width:0}.monthly-news .augx-tag{display:inline-block;color:#e0b678;font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;border-bottom:1px solid #704837;padding-bottom:5px}.monthly-news .augx-text h3{font:700 clamp(26px,3vw,35px)/1.08 Georgia,serif!important;color:var(--gold)!important;margin:14px 0!important;padding:0!important;border:0!important;background:none!important;overflow-wrap:anywhere}.monthly-news .augx-text p{font-size:15px;line-height:1.7;color:var(--cream)!important;margin:0 0 15px!important}.monthly-news .sep-hook{display:block;font:700 20px/1.3 Georgia,serif;color:#f0dfb8;margin-bottom:14px}.monthly-news .augx-read{font-size:12px;font-weight:700}.monthly-news .sep-sources{font-size:11px!important;line-height:1.6!important;overflow-wrap:anywhere}.monthly-news .augx-type-tile{min-height:180px;display:flex;align-items:center;justify-content:center;text-align:center;font:700 40px/1.1 Georgia,serif;color:#d8bd75;background:linear-gradient(135deg,#5e2330,#242025);padding:24px}\n.monthly-news .monthly-farewell{border-bottom:1px solid var(--line);margin-bottom:30px;padding-bottom:30px}.monthly-news .monthly-farewell h2{font:700 26px/1.2 Georgia,serif!important;color:var(--gold)!important;margin:0 0 20px!important;background:none!important;border:0!important;padding:0!important}.monthly-news .monthly-farewell .augx-card{border-top-color:#b9a483}\n.monthly-news .monthly-notes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:24px}.monthly-news .augx-brief{padding:20px;background:#1b1d20;border:1px solid var(--line);border-left:3px solid #842b34;min-width:0}.monthly-news .augx-brief strong{font:700 22px/1.25 Georgia,serif;color:var(--gold);display:block;margin-bottom:10px}.monthly-news .augx-brief p{color:var(--cream)!important;font-size:14px;line-height:1.65;margin:0 0 10px!important}.monthly-news .augx-foot{margin-top:32px;border-top:1px solid var(--line);padding-top:22px;color:var(--muted);font-size:12px;overflow-wrap:anywhere}.monthly-news .augx-foot h2{font:700 23px/1.25 Georgia,serif!important;color:var(--gold)!important;margin:0 0 14px!important;padding:0!important;border:0!important;background:none!important}.monthly-news .augx-foot p{color:var(--muted)!important;font-size:12px;margin:0 0 12px!important}.monthly-news .augx-foot li{margin:7px 0}.monthly-news .augx-strip{margin-top:28px;padding:20px;background:#3c2128;border-left:3px solid var(--gold);color:#ebddc1;font-size:15px}\n@media(max-width:700px){.monthly-news .monthly-banner{grid-template-columns:minmax(0,1fr) 155px;min-height:300px;padding:30px 24px;gap:10px}.monthly-news .monthly-title{font-size:46px!important}.monthly-news .monthly-brand{font-size:10px;margin-bottom:20px}.monthly-news .monthly-summary{font-size:13px!important}.monthly-news .monthly-label{font-size:12px}.monthly-news .monthly-label small{font-size:6px}.monthly-news .augx-grid,.monthly-news .monthly-notes{grid-template-columns:1fr}.monthly-news .augx-portrait img{height:230px!important}}\n@media(max-width:460px){.monthly-news[lang=\"en\"] .monthly-title{font-size:40px!important}.monthly-news{width:calc(100vw - 20px)}.monthly-news .monthly-banner{display:block;padding:30px 24px 26px}.monthly-news .monthly-art{position:absolute;width:170px;right:-53px;top:44px;opacity:.34;z-index:-1}.monthly-news .monthly-title{font-size:52px!important;max-width:245px}.monthly-news .monthly-summary{max-width:265px}.monthly-news .monthly-kicker{font-size:9px}.monthly-news .monthly-range{font-size:10px}.monthly-news .monthly-body{padding:20px 14px 28px}.monthly-news .augx-text{padding:20px}.monthly-news .augx-portrait img{height:220px!important}}\n\n\n.monthly-news .monthly-banner{min-height:470px;padding:44px 48px;grid-template-columns:minmax(0,1.65fr) minmax(250px,1fr);gap:0;background:radial-gradient(ellipse at 85% 45%,#8f603c44,transparent 52%),linear-gradient(115deg,#69182a 0%,#31171f 43%,#141315 100%)}\n.monthly-news .monthly-banner:before{inset:16px;border-color:#d8bd7555}\n.monthly-news .monthly-brand{font-size:14px;letter-spacing:.2em;margin-bottom:36px}\n.monthly-news .monthly-kicker{font-size:11px;letter-spacing:.24em;color:#f0d8a8;margin-bottom:15px}\n.monthly-news .monthly-title{font-size:clamp(68px,8.3vw,112px)!important;line-height:.96!important;letter-spacing:-.045em;margin:0 0 17px!important;text-shadow:0 4px 22px #0003;position:relative;z-index:2}\n.monthly-news .monthly-title span{display:inline;color:#cda56a;font-size:.77em;letter-spacing:-.035em;margin-left:13px}\n.monthly-news .monthly-headline{font-family:Georgia,serif!important;font-size:clamp(28px,3.7vw,46px)!important;line-height:1.1!important;color:#fff1d2!important;font-weight:400!important;letter-spacing:.03em!important;margin:0 0 22px!important;padding:0!important;border:0!important;background:none!important}\n.monthly-news .monthly-summary{font-size:15px!important;max-width:470px;line-height:1.65!important;color:#d6c3b3!important}\n.monthly-news .monthly-range{display:inline-block;font-size:10px;letter-spacing:.14em;margin-top:28px;padding:9px 0;border-top:1px solid #b8956266}\n.monthly-news .monthly-art{width:360px;max-width:100%;justify-self:end}\n.monthly-news .monthly-art:before{content:'08';position:absolute;top:-67px;right:-9px;font:italic 180px/1 Georgia,serif;color:#cfb58012;z-index:-1}\n.monthly-news .monthly-record{max-width:340px;box-shadow:0 24px 50px #000b,0 0 0 1px #d8bd7580,0 0 0 16px #d8bd7508,0 0 0 17px #d8bd7522}\n.monthly-news .monthly-label{font-size:22px;background:radial-gradient(circle,#9b3144,#62182a);border-color:#d4b475}\n.monthly-news .monthly-label small{font-size:9px}\n@media(max-width:900px){.monthly-news .monthly-banner{padding:38px 32px;min-height:410px;grid-template-columns:minmax(0,1.6fr) minmax(185px,1fr)}.monthly-news .monthly-title{font-size:80px!important}.monthly-news .monthly-title span{display:block;margin:10px 0 0;font-size:.66em}.monthly-news .monthly-headline{font-size:34px!important}.monthly-news .monthly-art{width:240px}.monthly-news .monthly-brand{font-size:11px}.monthly-news .monthly-label{font-size:16px}}\n@media(max-width:600px){.monthly-news .monthly-banner{display:block;min-height:440px;padding:34px 27px 30px}.monthly-news .monthly-brand{font-size:10px;margin-bottom:35px}.monthly-news .monthly-kicker{font-size:9px;letter-spacing:.18em;max-width:230px}.monthly-news .monthly-title,.monthly-news[lang=\"en\"] .monthly-title{font-size:70px!important;max-width:none;letter-spacing:-.05em}.monthly-news .monthly-title span{display:block;font-size:48px;margin:10px 0 0;letter-spacing:.04em}.monthly-news .monthly-headline{font-size:32px!important;max-width:280px;margin-bottom:18px!important}.monthly-news .monthly-summary{font-size:13px!important;max-width:260px}.monthly-news .monthly-art{position:absolute;width:200px;right:-55px;top:155px;opacity:.32;z-index:-1}.monthly-news .monthly-art:before{display:none}.monthly-news .monthly-range{font-size:9px;max-width:260px;margin-top:25px}.monthly-news[lang=\"en\"] .monthly-title{font-size:48px!important}}\n\n\n.monthly-news[lang=\"en\"] .monthly-title{font-size:clamp(48px,5.2vw,70px)!important}@media(max-width:900px){.monthly-news[lang=\"en\"] .monthly-title{font-size:56px!important}}@media(max-width:600px){.monthly-news[lang=\"en\"] .monthly-title{font-size:46px!important}}\n\n.monthly-news[data-month=\"08\"][lang=\"tr\"] .monthly-title{font-size:clamp(54px,6.3vw,86px)!important}@media(max-width:600px){.monthly-news[data-month=\"08\"][lang=\"tr\"] .monthly-title{font-size:56px!important}}\n</style>\n<div class=\"monthly-news\" lang=\"tr\" data-month=\"08\" data-template=\"monthly-news-v2\"><header class=\"monthly-banner\"><div><span class=\"monthly-brand\">OLDIES RADYO · MUSIC NEWS</span><span class=\"monthly-kicker\">AYIN MÜZİK HABERLERİ</span><h1 class=\"monthly-title\">AĞUSTOS<span>2026</span></h1><h2 class=\"monthly-headline\">Müzik Haberleri</h2><p class=\"monthly-summary\">Efsanelerin sahneye dönüşleri, yeni kayıtlar ve ayın öne çıkan gelişmeleri. Oldies Radyo’nun aylık müzik dosyası.</p><span class=\"monthly-range\">1–31 Ağustos 2026 · OLDIES RADYO</span></div><div class=\"monthly-art\" aria-hidden=\"true\"><div class=\"monthly-record\"><div class=\"monthly-label\">OLDIES<br>RADYO<small>33⅓ RPM</small></div></div></div></header><div class=\"monthly-body\"><section class=\"monthly-farewell\"><h2>VEDALAR</h2><div class=\"augx-grid\"><article class=\"augx-card\"><figure class=\"augx-portrait\"><img src=\"https://upload.wikimedia.org/wikipedia/commons/b/b0/Dolly_Parton_2014.jpg?utm_campaign=index&amp;utm_content=original&amp;utm_source=commons.wikimedia.org\" alt=\"DOLLY PARTON arşiv fotoğrafı\" loading=\"lazy\"><figcaption>2014 · <a href=\"https://commons.wikimedia.org/wiki/File:Dolly_Parton_2014.jpg\">Kris Harris King</a> · <a href=\"https://creativecommons.org/licenses/by-sa/3.0/\">CC BY-SA 3.0</a><br>Arşiv fotoğrafı · İlgili Ağustos olayından değildir. Görsel kırpılmadı.</figcaption></figure><div class=\"augx-text\"><div class=\"augx-tag\">25 AĞUSTOS · VEDA</div><h3>DOLLY PARTON</h3><p>Country müziğin dünya çapındaki sesi 80 yaşında hayatını kaybetti. “Jolene”, “9 to 5” ve “I Will Always Love You” kuşakları birbirine bağlayan mirasının yalnızca bir bölümü.</p><a class=\"augx-read\" href=\"https://oldiesradyo.com/2026/08/28/dolly-parton-80-yasinda-hayatini-kaybetti-country-muzigin-efsane-ismi-ardinda-dev-bir-miras-birakti/\">Haberin tamamı →</a></div></article><article class=\"augx-card\"><figure class=\"augx-portrait\"><img src=\"https://upload.wikimedia.org/wikipedia/commons/a/a9/Frank_Beard_of_ZZ_Top_performing_in_San_Antonio%2C_Texas_2015.jpg\" alt=\"FRANK BEARD arşiv fotoğrafı\" loading=\"lazy\"><figcaption>2015 · <a href=\"https://commons.wikimedia.org/wiki/File:Frank_Beard_of_ZZ_Top_performing_in_San_Antonio,_Texas_2015.jpg\">Ralph Arvesen</a> · <a href=\"https://creativecommons.org/licenses/by/2.0/\">CC BY 2.0</a><br>Arşiv fotoğrafı · İlgili Ağustos olayından değildir. Görsel kırpılmadı.</figcaption></figure><div class=\"augx-text\"><div class=\"augx-tag\">AĞUSTOS · VEDA</div><h3>FRANK BEARD</h3><p>ZZ Top’ın yarım yüzyılı aşkın süre davulunda olan Beard 77 yaşında hayatını kaybetti. “La Grange” ve “Legs” gibi şarkıların sıkı ritmi onun imzasını taşıyordu.</p><a class=\"augx-read\" href=\"https://oldiesradyo.com/frank-beard-zz-top-hayatini-kaybetti/\">Haberin tamamı →</a></div></article></div></section><div class=\"augx-grid\"><article class=\"augx-card\"><figure class=\"augx-portrait\"><img src=\"https://upload.wikimedia.org/wikipedia/commons/9/90/Deep_Purple%2C_Ritchie_Blackmore_1970.jpg\" alt=\"RITCHIE BLACKMORE arşiv fotoğrafı\" loading=\"lazy\"><figcaption>1970 · <a href=\"https://commons.wikimedia.org/wiki/File:Deep_Purple,_Ritchie_Blackmore_1970.jpg\">W.W.Thaler</a> · <a href=\"https://creativecommons.org/licenses/by-sa/3.0/\">CC BY-SA 3.0</a><br>Arşiv fotoğrafı · İlgili Ağustos olayından değildir. Görsel kırpılmadı.</figcaption></figure><div class=\"augx-text\"><div class=\"augx-tag\">12 AĞUSTOS · SAHNE</div><h3>RITCHIE BLACKMORE</h3><p>Deep Purple ile yeniden aynı sahneye çıktı ve “Smoke on the Water”ı çaldı. Bu özel buluşmanın ardından kalıcı bir birleşme duyurulmadı.</p><a class=\"augx-read\" href=\"https://oldiesradyo.com/ritchie-blackmore-deep-purple-33-yil-sonra/\">Haberin tamamı →</a></div></article><article class=\"augx-card\"><figure class=\"augx-portrait\"><img src=\"https://upload.wikimedia.org/wikipedia/commons/7/74/Sheryl_crow_%2847966331833%29.jpg\" alt=\"SHERYL CROW arşiv fotoğrafı\" loading=\"lazy\"><figcaption>2019 · <a href=\"https://commons.wikimedia.org/wiki/File:Sheryl_crow_(47966331833).jpg\">Zach Catanzareti</a> · <a href=\"https://creativecommons.org/licenses/by/2.0/\">CC BY 2.0</a><br>Arşiv fotoğrafı · İlgili Ağustos olayından değildir. Görsel kırpılmadı.</figcaption></figure><div class=\"augx-text\"><div class=\"augx-tag\">AĞUSTOS · YENİ ALBÜM</div><h3>SHERYL CROW</h3><p>Yedi şarkılık Pick You Up albümünü duyurdu. Albüm için açıklanan tarih 9 Ekim; “Freedom Bus” ilk paylaşılan şarkılardan biri.</p><a class=\"augx-read\" href=\"https://oldiesradyo.com/sheryl-crow-pick-you-up-2026/\">Haberin tamamı →</a></div></article><article class=\"augx-card\"><figure class=\"augx-portrait\"><img src=\"https://upload.wikimedia.org/wikipedia/commons/2/27/Rod_Stewart.jpg\" alt=\"ROD STEWART arşiv fotoğrafı\" loading=\"lazy\"><figcaption>archive · <a href=\"https://commons.wikimedia.org/wiki/File:Rod_Stewart.jpg\">Pascal Kirchmair</a> · <a href=\"https://creativecommons.org/licenses/by-sa/3.0/\">CC BY-SA 3.0</a><br>Arşiv fotoğrafı · İlgili Ağustos olayından değildir. Görsel kırpılmadı.</figcaption></figure><div class=\"augx-text\"><div class=\"augx-tag\">AĞUSTOS · SAĞLIK</div><h3>ROD STEWART</h3><p>Kalp işleminin ardından doktorların dinlenme önerisiyle bazı konserlerini erteledi. Ağustos haberimiz, o gün açıklanan program değişikliklerini aktarıyor.</p><a class=\"augx-read\" href=\"https://oldiesradyo.com/rod-stewart-kalp-operasyonu-2026/\">Haberin tamamı →</a></div></article><article class=\"augx-card\"><figure class=\"augx-portrait\"><img src=\"https://upload.wikimedia.org/wikipedia/commons/7/70/Neil_Young_Stavernfestivalen_2016_%28220929%29.jpg\" alt=\"NEIL YOUNG arşiv fotoğrafı\" loading=\"lazy\"><figcaption>2016 · <a href=\"https://commons.wikimedia.org/wiki/File:Neil_Young_Stavernfestivalen_2016_(220929).jpg\">Tore Sætre</a> · <a href=\"https://creativecommons.org/licenses/by-sa/4.0/\">CC BY-SA 4.0</a><br>Arşiv fotoğrafı · İlgili Ağustos olayından değildir. Görsel kırpılmadı.</figcaption></figure><div class=\"augx-text\"><div class=\"augx-tag\">AĞUSTOS · YENİ MÜZİK</div><h3>NEIL YOUNG</h3><p>The Chrome Hearts ile Second Song çalışmasını duyurdu. Ayın ilk günleri, Heart ve Elvis Costello gibi isimlerden yeni yayın haberleri de getirdi.</p><a class=\"augx-read\" href=\"https://oldiesradyo.com/muzik-haberleri/\">Tüm müzik haberleri →</a></div></article><article class=\"augx-card\"><figure class=\"augx-portrait\"><img src=\"https://upload.wikimedia.org/wikipedia/commons/d/d6/Paul_McCartney_in_October_2018.jpg\" alt=\"PAUL McCARTNEY arşiv fotoğrafı\" loading=\"lazy\"><figcaption>2018 · <a href=\"https://commons.wikimedia.org/wiki/File:Paul_McCartney_in_October_2018.jpg\">Raph_PH</a> · <a href=\"https://creativecommons.org/licenses/by/2.0/\">CC BY 2.0</a><br>Arşiv fotoğrafı · İlgili Ağustos olayından değildir. Görsel kırpılmadı.</figcaption></figure><div class=\"augx-text\"><div class=\"augx-tag\">1 AĞUSTOS · ÖDÜL</div><h3>PAUL McCARTNEY</h3><p>Kariyerinin ilk Mercury Prize adaylığını aldı. Bu gelişme, ayın haber akışında Beatles sonrası üretkenliğini yeniden öne çıkardı.</p><a class=\"augx-read\" href=\"https://oldiesradyo.com/paul-mccartney-ilk-mercury-prize-adayligi-2026/\">Haberin tamamı →</a></div></article><article class=\"augx-card\"><div class=\"augx-type-tile\" role=\"img\" aria-label=\"NEW RADICALS\">NEW<br>RADICALS</div><div class=\"augx-text\"><div class=\"augx-tag\">3 AĞUSTOS · GERİ DÖNÜŞ</div><h3>NEW RADICALS</h3><p>“You Get What You Give” ile hatırlanan grup, 28 yıl sonra yeni ve özgün bir kayıtla dinleyicisinin karşısına çıktı.</p><a class=\"augx-read\" href=\"https://oldiesradyo.com/new-radicals-28-yil-sonra-yeni-sarki/\">Haberin tamamı →</a></div></article></div><div class=\"monthly-notes\"><div class=\"augx-brief\"><strong>Journey</strong><p>Final Frontier turnesinin son ABD bölümünü açıkladı.</p></div><div class=\"augx-brief\"><strong>Jethro Tull</strong><p>14 Kasım İstanbul konseri duyuruldu.</p></div><div class=\"augx-brief\"><strong>Madonna &amp; Kylie Minogue</strong><p>“Love Sensation” İngiltere listesinde dikkat çekti.</p></div><div class=\"augx-brief\"><strong>Elvis Presley</strong><p>Elvis Week, Graceland’daki geleneksel anmayla tamamlandı.</p></div><div class=\"augx-brief\"><strong>Whitney Houston</strong><p>Mirasına odaklanan koleksiyon ve Barbie projesi haber oldu.</p></div><div class=\"augx-brief\"><strong>Glenn Hughes</strong><p>Doktor tavsiyesi sonrası canlı performansları bırakacağını açıkladı.</p></div></div><div class=\"augx-strip\">Oldies Radyo’dan söylemesi: Ağustosun hikâyesi yalnızca geçmişe bakmakla ilgili değil. Bu şarkılar hâlâ yeni buluşmaların, yeni kayıtların ve dolan konser salonlarının içinde yaşıyor.</div><div class=\"augx-foot\"><h2>Kaynaklar ve görsel kredileri</h2><p>Haberler Ağustos 2026’da yapılan açıklamaların özetidir. Sağlık ve turne durumu daha sonra değişmiş olabilir. Tüm yazılar için Yeni Haberler arşivine bakın. <a href=\"https://oldiesradyo.com/muzik-haberleri/\">Yeni Haberler</a>.</p><p><a href=\"https://apnews.com/article/87156f3e6a1547b88bf414529b644ad3\">Associated Press: Dolly Parton</a> · <a href=\"https://apnews.com/article/72139238d1dbf3d277bdb3b8584eecc9\">Associated Press: Frank Beard</a> · <a href=\"https://oldiesradyo.com/muzik-haberleri/\">Oldies Radyo: Müzik Haberleri arşivi</a>.</p><p class=\"augx-credit\">Her fotoğrafın altında eser sahibi ve lisans bağlantısı bulunur. Fotoğraflar arşiv görüntüleridir; Ağustos 2026 olaylarının fotoğrafı olarak sunulmaz.</p></div></div></div>\n<!-- /wp:html -->"
